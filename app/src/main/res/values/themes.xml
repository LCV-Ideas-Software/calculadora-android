<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A interface inteira é Compose: este tema só decide o que a janela mostra
      entre o toque no ícone e o primeiro quadro desenhado. O tema de
      plataforma evita trazer a biblioteca de componentes de visualização só
      para isso. Não há variante `values-night`: a interface é clara em
      qualquer modo do aparelho (desvio declarado na especificação), e uma
      janela escura antes dela seria só uma piscada escura.
    -->
    <style name="Theme.Calculadora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/janela</item>
    </style>
</resources>
